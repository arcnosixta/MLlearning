Функция ТекущийОстаток(Товар) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Остатки.Товар КАК Товар,
    | Остатки.КоличествоОстаток КАК Количество
    |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК Остатки";
    Запрос.УстановитьПараметр("Товар", Товар);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
